--[[
SAFE FLOW SCANNER
Versão de baixa invasividade para executores móveis.

O que captura:
- Script inicial
- Todo código que passar por loadstring
- Respostas de request/http_request/syn.request que pareçam Lua
- Criação e alterações de UI em CoreGui / PlayerGui
- Cliques em TextButton/ImageButton
- URLs copiadas para clipboard
- Possíveis mensagens de key válida/inválida
- Resumo com o último e o maior payload Lua capturado

O que NÃO faz:
- Não usa hookmetamethod
- Não hooka __namecall / __newindex
- Não hooka Instance.new / Destroy
- Não hooka game.HttpGet
- Não registra o texto digitado em TextBox
- Não envia logs para servidor externo
]]

local TARGET_URL = "https://raw.githubusercontent.com/yumyum272/driving/refs/heads/main/script1.lua"

local G = (getgenv and getgenv()) or _G
local unpack_ = table.unpack or unpack

local SESSION = "SafeFlowScan_" .. tostring(os.time())
local LOG_FILE = SESSION .. "_log.txt"
local SUMMARY_FILE = SESSION .. "_summary.txt"

local START = os.clock()
local LOGS = {}
local CAPTURES = {}
local COUNTER = 0
local UI_SEEN = setmetatable({}, {__mode = "k"})
local CONNECTIONS = {}

local function now()
    return string.format("%.3f", os.clock() - START)
end

local function safe(v)
    local ok, result = pcall(function()
        if typeof and typeof(v) == "Instance" then
            return v:GetFullName()
        end
        return tostring(v)
    end)
    return ok and result or "<erro>"
end

local function log(tag, msg)
    local line = string.format("[%s] [%s] %s", now(), tostring(tag), tostring(msg))
    LOGS[#LOGS + 1] = line
    print("[SAFE-FLOW] " .. line)
end

local function flush()
    if type(writefile) == "function" then
        pcall(writefile, LOG_FILE, table.concat(LOGS, "\n"))
    end
end

local function redact(s)
    if type(s) ~= "string" then
        return safe(s)
    end

    if s:match("^https?://") then
        return s
    end

    local low = s:lower()
    if low:find("key=", 1, true)
    or low:find("token=", 1, true)
    or low:find("authorization", 1, true)
    or low:find("bearer ", 1, true)
    or low:find("license=", 1, true) then
        return "<redigido>"
    end

    if #s >= 24 and s:match("^[%w%-%._]+$") then
        return "<redigido>"
    end

    if #s > 220 then
        return s:sub(1, 220) .. string.format("... <%d chars>", #s)
    end

    return s
end

local function looksLikeLua(s)
    if type(s) ~= "string" or #s < 40 then
        return false
    end

    local score = 0
    if s:find("local ", 1, true) then score += 1 end
    if s:find("function", 1, true) then score += 1 end
    if s:find("return", 1, true) then score += 1 end
    if s:find("game", 1, true) then score += 1 end
    if s:find("GetService", 1, true) then score += 1 end
    if s:find("Instance.new", 1, true) then score += 1 end
    if s:find("loadstring", 1, true) then score += 1 end
    if s:find("--[[", 1, true) then score += 1 end

    return score >= 2
end

local function saveCapture(kind, source, meta)
    if type(source) ~= "string" or #source == 0 then
        return nil
    end

    COUNTER += 1
    local file = string.format(
        "%s_%03d_%s.txt",
        SESSION,
        COUNTER,
        tostring(kind):gsub("[^%w_%-]", "_")
    )

    local entry = {
        index = COUNTER,
        kind = tostring(kind),
        file = file,
        bytes = #source,
        luaLike = looksLikeLua(source),
        meta = tostring(meta or ""),
        time = now()
    }

    CAPTURES[#CAPTURES + 1] = entry

    if type(writefile) == "function" then
        pcall(writefile, file, source)
    end

    log(
        "CAPTURE",
        string.format(
            "#%03d | %s | %d bytes | lua=%s | %s",
            entry.index,
            entry.kind,
            entry.bytes,
            tostring(entry.luaLike),
            entry.meta
        )
    )

    flush()
    return file
end

local function detectKeyMessage(text)
    if type(text) ~= "string" then
        return
    end

    local low = text:lower()

    if low:find("success", 1, true)
    or low:find("valid", 1, true)
    or low:find("accepted", 1, true)
    or low:find("correct", 1, true)
    or low:find("sucesso", 1, true)
    or low:find("válid", 1, true)
    or low:find("valida", 1, true) then
        log("KEY-STATE", "Possível confirmação POSITIVA: " .. redact(text))
    elseif low:find("invalid", 1, true)
    or low:find("incorrect", 1, true)
    or low:find("error", 1, true)
    or low:find("inválid", 1, true)
    or low:find("incorreta", 1, true) then
        log("KEY-STATE", "Possível confirmação NEGATIVA: " .. redact(text))
    end
end

-- ============================================================
-- WRAPPER SEGURO DE loadstring
-- ============================================================

local ORIGINAL_LOADSTRING = rawget(G, "loadstring") or loadstring

if type(ORIGINAL_LOADSTRING) == "function" then
    local SAFE_LOADSTRING = function(source, chunkName, ...)
        if type(source) == "string" then
            local file = saveCapture(
                "loadstring",
                source,
                "chunk=" .. tostring(chunkName or "?")
            )
            log(
                "LOADSTRING",
                string.format(
                    "%d bytes | arquivo=%s",
                    #source,
                    tostring(file)
                )
            )
        end

        return ORIGINAL_LOADSTRING(source, chunkName, ...)
    end

    local ok = pcall(function()
        G.loadstring = SAFE_LOADSTRING
    end)

    log("WRAP", "loadstring=" .. tostring(ok))
else
    log("WARN", "loadstring indisponível")
end

-- ============================================================
-- WRAPPERS SEGUROS DE REQUEST
-- ============================================================

local function installRequestWrapper(container, field, label)
    local okRead, original = pcall(function()
        return container[field]
    end)

    if not okRead or type(original) ~= "function" then
        return
    end

    local wrapped = function(options, ...)
        local url = "?"
        local method = "GET"

        if type(options) == "table" then
            url = options.Url or options.URL or options.url or "?"
            method = options.Method or options.method or "GET"
        else
            url = safe(options)
        end

        log("HTTP", tostring(method) .. " " .. tostring(url))

        local results = {original(options, ...)}
        local response = results[1]

        if type(response) == "table" then
            local status = response.StatusCode or response.Status or response.status_code
            local body = response.Body or response.body

            log(
                "HTTP-RESPONSE",
                string.format(
                    "%s | status=%s | bytes=%s",
                    tostring(url),
                    safe(status),
                    type(body) == "string" and tostring(#body) or "?"
                )
            )

            if looksLikeLua(body) then
                saveCapture(label .. "_response", body, url)
            end
        elseif type(response) == "string" and looksLikeLua(response) then
            saveCapture(label .. "_response", response, url)
        end

        return unpack_(results)
    end

    local okWrite = pcall(function()
        container[field] = wrapped
    end)

    log("WRAP", label .. "=" .. tostring(okWrite))
end

installRequestWrapper(G, "request", "request")
installRequestWrapper(G, "http_request", "http_request")
installRequestWrapper(G, "httprequest", "httprequest")

if type(rawget(G, "syn")) == "table" then
    installRequestWrapper(G.syn, "request", "syn_request")
end

-- ============================================================
-- CLIPBOARD
-- ============================================================

do
    local original = rawget(G, "setclipboard") or setclipboard

    if type(original) == "function" then
        local wrapped = function(value, ...)
            if type(value) == "string" and value:match("^https?://") then
                log("CLIPBOARD", value)
            else
                log("CLIPBOARD", "<conteúdo omitido>")
            end
            return original(value, ...)
        end

        local ok = pcall(function()
            G.setclipboard = wrapped
        end)

        log("WRAP", "setclipboard=" .. tostring(ok))
    end
end

-- ============================================================
-- MONITOR PASSIVO DE UI
-- ============================================================

local function isRelevantUI(obj)
    if not obj or not obj:IsA("GuiObject") and not obj:IsA("ScreenGui") then
        return false
    end

    return obj:IsA("ScreenGui")
        or obj:IsA("Frame")
        or obj:IsA("TextLabel")
        or obj:IsA("TextButton")
        or obj:IsA("TextBox")
        or obj:IsA("ImageButton")
        or obj:IsA("ImageLabel")
end

local function bindUI(obj)
    if UI_SEEN[obj] or not isRelevantUI(obj) then
        return
    end

    UI_SEEN[obj] = true
    log("UI-CREATE", obj.ClassName .. " -> " .. safe(obj))

    local function observeProperty(prop)
        local ok = pcall(function()
            local signal = obj:GetPropertyChangedSignal(prop)
            local conn = signal:Connect(function()
                local success, value = pcall(function()
                    return obj[prop]
                end)

                if not success then
                    return
                end

                if obj:IsA("TextBox") and prop == "Text" then
                    log("UI-SET", safe(obj) .. ".Text = <redigido>")
                    return
                end

                if type(value) == "string" then
                    log("UI-SET", safe(obj) .. "." .. prop .. " = " .. redact(value))
                    if prop == "Text" then
                        detectKeyMessage(value)
                    end
                else
                    log("UI-SET", safe(obj) .. "." .. prop .. " = " .. safe(value))
                end
            end)

            CONNECTIONS[#CONNECTIONS + 1] = conn
        end)

        return ok
    end

    observeProperty("Name")

    if obj:IsA("TextLabel") or obj:IsA("TextButton") or obj:IsA("TextBox") then
        observeProperty("Text")
    end

    if obj:IsA("TextBox") then
        observeProperty("PlaceholderText")
    end

    if obj:IsA("GuiObject") then
        observeProperty("Visible")
    end

    if obj:IsA("ScreenGui") then
        observeProperty("Enabled")
    end

    if obj:IsA("TextButton") then
        local ok = pcall(function()
            local conn = obj.MouseButton1Click:Connect(function()
                local text = ""
                pcall(function()
                    text = obj.Text
                end)
                log("BUTTON", safe(obj) .. " | Text=" .. redact(text))
            end)
            CONNECTIONS[#CONNECTIONS + 1] = conn
        end)
    elseif obj:IsA("ImageButton") then
        local ok = pcall(function()
            local conn = obj.MouseButton1Click:Connect(function()
                log("BUTTON", safe(obj))
            end)
            CONNECTIONS[#CONNECTIONS + 1] = conn
        end)
    end
end

local function watchRoot(root, label)
    if not root then
        return
    end

    log("WATCH", label .. " -> " .. safe(root))

    pcall(function()
        for _, obj in ipairs(root:GetDescendants()) do
            bindUI(obj)
        end
    end)

    pcall(function()
        local conn = root.DescendantAdded:Connect(function(obj)
            bindUI(obj)
        end)
        CONNECTIONS[#CONNECTIONS + 1] = conn
    end)
end

pcall(function()
    local Players = game:GetService("Players")
    local player = Players.LocalPlayer
    if player then
        local playerGui = player:FindFirstChildOfClass("PlayerGui") or player:WaitForChild("PlayerGui", 5)
        watchRoot(playerGui, "PlayerGui")
    end
end)

pcall(function()
    local CoreGui = game:GetService("CoreGui")
    watchRoot(CoreGui, "CoreGui")
end)

-- ============================================================
-- RESUMO
-- ============================================================

local function makeSummary()
    local lines = {}
    lines[#lines + 1] = "SAFE FLOW SCAN SUMMARY"
    lines[#lines + 1] = "Session: " .. SESSION
    lines[#lines + 1] = "Captures: " .. tostring(#CAPTURES)
    lines[#lines + 1] = ""

    local lastLua = nil
    local largestLua = nil

    for _, c in ipairs(CAPTURES) do
        lines[#lines + 1] = string.format(
            "#%03d | %s | %d bytes | lua=%s | %s | %s",
            c.index,
            c.kind,
            c.bytes,
            tostring(c.luaLike),
            c.file,
            c.meta
        )

        if c.luaLike then
            lastLua = c
            if not largestLua or c.bytes > largestLua.bytes then
                largestLua = c
            end
        end
    end

    lines[#lines + 1] = ""

    if lastLua then
        lines[#lines + 1] = "ULTIMO PAYLOAD LUA CAPTURADO:"
        lines[#lines + 1] = lastLua.file
        lines[#lines + 1] = tostring(lastLua.bytes) .. " bytes"
    end

    lines[#lines + 1] = ""

    if largestLua then
        lines[#lines + 1] = "MAIOR PAYLOAD LUA CAPTURADO:"
        lines[#lines + 1] = largestLua.file
        lines[#lines + 1] = tostring(largestLua.bytes) .. " bytes"
    end

    return table.concat(lines, "\n")
end

G.SAFE_FLOW_SCAN_STOP = function()
    for _, conn in ipairs(CONNECTIONS) do
        pcall(function()
            conn:Disconnect()
        end)
    end

    flush()

    local summary = makeSummary()

    if type(writefile) == "function" then
        pcall(writefile, SUMMARY_FILE, summary)
    end

    print("\n========== SAFE FLOW SUMMARY ==========\n" .. summary .. "\n=======================================\n")
    return summary
end

-- ============================================================
-- EXECUÇÃO DO ALVO
-- ============================================================

local function runTarget()
    if type(ORIGINAL_LOADSTRING) ~= "function" then
        error("loadstring indisponível")
    end

    log("RUN", "Baixando script inicial")

    local source = game:HttpGet(TARGET_URL)

    log("RUN", "Script inicial recebido: " .. tostring(#source) .. " bytes")
    saveCapture("initial_target", source, TARGET_URL)

    local chunk, compileErr = ORIGINAL_LOADSTRING(source, "@SAFE_FLOW_TARGET")

    if not chunk then
        error("Falha ao compilar: " .. tostring(compileErr))
    end

    log("RUN", "Executando script alvo")

    local ok, err = pcall(chunk)

    if not ok then
        log("TARGET-ERROR", safe(err))
    else
        log("RUN", "Execução inicial concluída")
    end

    flush()
end

local ok, err = pcall(runTarget)

if not ok then
    log("SCANNER-ERROR", safe(err))
end

log("INFO", "Use a interface normalmente.")
log("INFO", "Ao terminar, execute: getgenv().SAFE_FLOW_SCAN_STOP()")
flush()
